{
  "version": "2.0.0",
  "project": "advogado-civel-ia",
  "description": "Sistema modular de redacao juridica com separacao de papeis por contrato entre agentes.",

  "agents": [
    {
      "id": "advogado",
      "name": "Advogado Civilista — Orquestrador",
      "description": "Agente principal de estrategia juridica. Triagem, decisao de rito, coleta de dados e coordenacao do estagiario via contrato.",
      "system_prompt_file": "advogado.md",
      "model": "claude-sonnet-4-20250514",
      "mode": "orchestrator",
      "capabilities": [
        "triagem_de_dominio",
        "selecao_de_rito",
        "geracao_de_contrato",
        "revisao_de_peca",
        "delta_incremental",
        "comandos_de_controle"
      ],
      "reads": [
        "roteamento.md",
        "contrato_decisao.md",
        "fontes.md",
        "verbetesSTF.md",
        "verbetesSTJ.md",
        "sumulas-vinculantes.md"
      ],
      "writes": ["contrato_decisao.md"],
      "delegates_to": "estagiario",
      "delegation_mode": "contrato",
      "control_commands": [
        "REINICIAR",
        "REVISAR",
        "GERAR PROCURACAO",
        "GERAR DECLARACAO",
        "GERAR ACORDO",
        "GERAR SUBSTABELECIMENTO",
        "GERAR ALVARA",
        "GERAR CUMPRIMENTO",
        "GERAR REPLICA",
        "GERAR REPLICA CIVEL",
        "GERAR DEMARCACAO",
        "GERAR RECURSO ESPECIAL",
        "GERAR RECURSO EXTRAORDINARIO"
      ],
      "autonomy": {
        "can_draft_directly": true,
        "conditions": [
          "peca simples sem ambiguidade estrategica",
          "documentos D1 e D2 em modo autonomo do estagiario"
        ]
      }
    },

    {
      "id": "estagiario",
      "name": "Estagiario Juridico — Executor Contratual",
      "description": "Agente executor de redacao juridica. Opera com base no contrato. Nao redefine estrategia. Emite Decisao Necessaria quando faltar campo minimo.",
      "system_prompt_file": "estagiario.md",
      "model": "claude-sonnet-4-20250514",
      "mode": "executor",
      "capabilities": [
        "redacao_juridica",
        "aplicacao_de_estilo",
        "execucao_de_deltas",
        "modo_autonomo_intermediarios",
        "emissao_de_decisao_necessaria"
      ],
      "reads": [
        "contrato_decisao.md",
        "estilo_juridico.md",
        "minuta-base.md",
        "minutas-imobiliarias.md",
        "minutas-consumeristas.md",
        "minutas-civeis.md",
        "minutas-intermediariais.md",
        "minutas-replica-alvara-cumprimento.md",
        "minutas-familia.md",
        "remedios-constitucionais.md",
        "mandado_seguranca.md"
      ],
      "writes": [],
      "reports_to": "advogado",
      "output": {
        "entregaveis": [
          "peca_redigida",
          "checklist_de_aderencia",
          "pendencias_explicitas",
          "resumo_de_alteracoes_por_rodada"
        ]
      },
      "autonomy": {
        "autonomous_documents_D1": ["PRO", "SUB", "HAB", "DHI", "ACO"],
        "autonomous_documents_D1_source": "minutas-intermediariais.md",
        "autonomous_documents_D2": ["REP", "ALV", "CPS"],
        "autonomous_documents_D2_source": "minutas-replica-alvara-cumprimento.md",
        "D2_requires_advogado_briefing_when": [
          "REP com preliminares complexas (incompetencia, prescricao, ilegitimidade)",
          "REP com documentos do reu a impugnar especificamente",
          "CPS sem memoria de calculo fornecida"
        ],
        "C_always_requires_advogado_briefing": [
          "RES — verificar prequestionamento, alinha CF e filtros de admissibilidade STJ",
          "REX — verificar prequestionamento, repercussao geral e Tema STF",
          "REP-C com preliminares complexas ou documentos novos a impugnar"
        ],
        "escalate_conditions": [
          "duas ou mais ordens plausíveis de etapas",
          "decisao entre bloquear fluxo ou seguir com ressalvas",
          "ausencia de criterio de sucesso mensuravel",
          "conflito entre pedido do usuario e base normativa"
        ]
      }
    }
  ],

  "knowledge_base": {
    "routing": "roteamento.md",
    "contract_template": "contrato_decisao.md",
    "style_guide": "estilo_juridico.md",
    "legal_sources": [
      "fontes.md",
      "sumulas-vinculantes.md",
      "verbetesSTF.md",
      "verbetesSTJ.md"
    ],
    "templates": {
      "base": "minuta-base.md",
      "A_imobiliario": "minutas-imobiliarias.md",
      "B_consumerista": "minutas-consumeristas.md",
      "C_civel": "minutas-civeis.md",
      "D1_intermediarios_extrajudiciais": "minutas-intermediariais.md",
      "D2_intermediarios_processuais": "minutas-replica-alvara-cumprimento.md",
      "E_familia": "minutas-familia.md",
      "F_remedios_constitucionais": "remedios-constitucionais.md",
      "G_mandado_seguranca": "mandado_seguranca.md"
    },
    "docx_templates": {
      "REP": "replica_contestacao.docx",
      "ALV": "expedicao_alvara.docx",
      "CPS": "cumprimento_sentenca.docx"
    }
  },

  "domains": [
    {
      "id": "A", "name": "Imobiliario",
      "template": "minutas-imobiliarias.md",
      "codes": ["RPO", "MPO", "IPR", "IPO", "REI", "CUS", "ANU", "PAF", "VIZ", "DEM"],
      "triggers": ["posse", "esbulho", "turbacao", "reintegracao", "interdito", "imissao", "reivindicatoria", "usucapiao", "vizinhanca", "anulatoria", "passagem forcada", "demarcacao de terras", "aviventacao de rumos", "marcos divisorios", "confinantes", "topografia"],
      "notes": "DEM: minuta reside em minutas-civeis.md (inserida junto ao dominio C por conveniencia de edicao), mas o dominio e materia imobiliaria (A)."
    },
    {
      "id": "B", "name": "Consumerista / JEC",
      "template": "minutas-consumeristas.md",
      "codes": ["PI", "NEG", "PSC", "PSN", "TEL", "TRO", "TRB", "DIS", "CEL", "RPR", "RI", "CR", "ED", "AI"],
      "triggers": ["CDC", "consumidor", "negativacao", "plano de saude", "telefonia", "overbooking", "distrato", "corte de energia", "vicio de produto", "reparo"]
    },
    {
      "id": "C", "name": "Civel Geral",
      "template": "minutas-civeis.md",
      "codes": ["ATR", "ALU", "REP-C", "RES", "REX"],
      "triggers": ["acidente de transito", "aluguel atrasado", "despejo", "locacao", "replica civel", "recurso especial", "recurso extraordinario", "STJ", "STF", "lei federal violada", "constituicao violada"],
      "notes": "minutas-civeis.md hospeda tambem a minuta DEM (dominio A) por conveniencia. Agentes devem buscar DEM neste arquivo mesmo sendo dominio A."
    },
    {
      "id": "D1", "name": "Intermediarios Extrajudiciais",
      "template": "minutas-intermediariais.md",
      "codes": ["PRO", "SUB", "HAB", "DHI", "ACO"],
      "triggers": ["procuracao", "substabelecimento", "habilitacao", "hipossuficiencia", "acordo"],
      "autonomous": true
    },
    {
      "id": "D2", "name": "Intermediarios Processuais",
      "template": "minutas-replica-alvara-cumprimento.md",
      "codes": ["REP", "ALV", "CPS"],
      "triggers": ["replica fase processual", "alvara", "cumprimento de sentenca", "penhora", "sisbajud", "levantamento de valores"],
      "autonomous": true,
      "autonomous_note": "REP requer briefing completo do advogado quando houver preliminares complexas. REP-C (replica em acoes civeis) reside em minutas-civeis.md — nao confundir."
    },
    {
      "id": "E", "name": "Familia e Sucessoes",
      "template": "minutas-familia.md",
      "codes": ["NEP", "INP", "ALI", "EXA", "INV"],
      "triggers": ["alimentos", "paternidade", "investigacao", "negatoria", "inventario", "partilha", "heranca", "pensao alimenticia", "execucao de alimentos", "prisao civil"]
    },
    {
      "id": "F", "name": "Remedios Constitucionais",
      "template": "remedios-constitucionais.md",
      "codes": ["AP", "HD", "HC"],
      "triggers": ["acao popular", "habeas data", "habeas corpus", "patrimonio publico", "dados pessoais", "prisao ilegal", "constrangimento ilegal"]
    },
    {
      "id": "G", "name": "Mandado de Seguranca",
      "template": "mandado_seguranca.md",
      "codes": ["MS"],
      "triggers": ["mandado de seguranca", "ato coator", "direito liquido e certo", "autoridade publica", "writ"]
    }
  ],

  "workflow": {
    "steps": [
      { "step": 1, "actor": "advogado", "action": "triagem", "source": "roteamento.md" },
      { "step": 2, "actor": "advogado", "action": "coleta_de_dados" },
      { "step": 3, "actor": "advogado", "action": "definir_modo", "options": ["autonomo", "integrado"] },
      { "step": 4, "actor": "advogado", "action": "gerar_contrato", "condition": "modo == integrado" },
      { "step": 5, "actor": "estagiario", "action": "redigir_peca" },
      { "step": 6, "actor": "advogado", "action": "revisar_e_delta" }
    ]
  },

  "inventory": {
    "total_pieces": 48,
    "breakdown": {
      "initial_petitions": 30,
      "appeals_incidentals_execution": 13,
      "ancillary_documents_D1": 5,
      "intermediary_procedural_D2": 3,
      "notes": "DEM inclusa em A (imobiliario). REP-C, RES, REX inclusos em C (civel). Replica civel (REP-C) distinta de replica processual (REP-D2)."
    },
    "docx_templates": 3
  }
}
